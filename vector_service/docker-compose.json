{
  "version": "3.8",
  "services": {
    "pgvector-db": {
      "image": "pgvector/pgvector:pg16",
      "container_name": "vector_db",
      "ports": [
        "5432:5432"
      ],
      "environment": {
        "POSTGRES_DB": "vectordb",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "your_secure_password"
      },
      "volumes": [
        "./init.sql:/docker-entrypoint-initdb.d/init.sql"
      ]
    }
  }
}
